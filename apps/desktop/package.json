{
  "name": "trung-kien-ai-hub",
  "productName": "Trung Kien AI Hub",
  "version": "0.3.0",
  "description": "Trung Kiên AI Hub - ứng dụng AI Agent cho Windows, chạy bằng Claude API",
  "private": true,
  "repository": "https://github.com/trungvip01951-lgtm/trung-kien-ai-hub",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && vite build",
    "test": "npm run build && node --test \"dist/main/*.test.js\"",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.1.6"
  },
  "build": {
    "appId": "vn.trungkien.aihub",
    "productName": "Trung Kien AI Hub",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "!dist/**/*.test.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "TrungKienAIHub-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "trungvip01951-lgtm",
        "repo": "trung-kien-ai-hub",
        "releaseType": "release"
      }
    ]
  }
}
