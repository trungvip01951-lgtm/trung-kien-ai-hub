{
  "name": "trung-kien-ai-hub",
  "productName": "Trung Kien AI Hub",
  "version": "0.0.1",
  "description": "Trung Kiên AI Hub - ứng dụng AI Agent cho Windows, chạy bằng Claude API",
  "private": true,
  "repository": "https://github.com/trungvip01951-lgtm/trung-kien-ai-hub",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "vn.trungkien.aihub",
    "productName": "Trung Kien AI Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
